# Common settings for the M1 benchmark (CYD and CoreS3)
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000
# The benchmark keeps a core busy for long stretches
CONFIG_ESP_TASK_WDT_INIT=n
# Step generation threads (steppersync.c uses one pthread per stepper)
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=6144
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
