CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_TASK_WDT_INIT=n
# Step generation threads (one per stepper/pwm_tool; ~1.2 KB measured)
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=3072
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# Console at the Klipper link rate, so the console UART can carry the link
# to the simulated MCU (tools/sim_bridge.py) without a baud rate change
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=250000
CONFIG_VFS_SUPPORT_TERMIOS=y
# Task list with stack high-water marks (heap diagnostics)
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y
# Room for LVGL and the UI (CYD has 4 MB flash)
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
